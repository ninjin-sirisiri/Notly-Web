---
import { getLocale, withLang } from '../lib/i18n';

const currentYear = new Date().getFullYear();
const locale = getLocale(Astro.url);
const copy = {
  ja: {
    taglineLine1: "毎日続けられる、",
    taglineLine2: "あなたのためのノートアプリ。",
    product: "プロダクト",
    support: "サポート",
    social: "ソーシャル",
    download: "ダウンロード",
    features: "機能",
    changelog: "更新履歴",
    faq: "FAQ",
    privacy: "プライバシーポリシー",
    terms: "利用規約",
    contact: "お問い合わせ",
    rights: "All rights reserved."
  },
  en: {
    taglineLine1: "A daily note app",
    taglineLine2: "made for your routine.",
    product: "Product",
    support: "Support",
    social: "Social",
    download: "Download",
    features: "Features",
    changelog: "Changelog",
    faq: "FAQ",
    privacy: "Privacy Policy",
    terms: "Terms of Service",
    contact: "Contact",
    rights: "All rights reserved."
  }
};
const t = copy[locale];
---

<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-brand">
        <h3>Notly</h3>
        <p>{t.taglineLine1}<br />{t.taglineLine2}</p>
      </div>
      <div class="footer-links">
        <div class="link-group">
          <h4>{t.product}</h4>
          <a href={withLang(`${import.meta.env.BASE_URL}/download/`, locale)}>{t.download}</a>
          <a href={withLang(`${import.meta.env.BASE_URL}#features`, locale)}>{t.features}</a>
          <a href={withLang(`${import.meta.env.BASE_URL}/changelog/`, locale)}>{t.changelog}</a>
        </div>
        <div class="link-group">
          <h4>{t.support}</h4>
          <a href={withLang(`${import.meta.env.BASE_URL}/faq/`, locale)}>{t.faq}</a>
          <a href={withLang(`${import.meta.env.BASE_URL}/privacy/`, locale)}>{t.privacy}</a>
          <a href={withLang(`${import.meta.env.BASE_URL}/terms/`, locale)}>{t.terms}</a>
          <a href={withLang(`${import.meta.env.BASE_URL}/contact/`, locale)}>{t.contact}</a>
        </div>
        <div class="link-group">
          <h4>{t.social}</h4>
          <a href="https://github.com/ninjin-sirisiri/Notly">GitHub</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; {currentYear} Notly. {t.rights}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 4rem 0 2rem;
    background: var(--bg-color); /* Match body bg */
    border-top: 1px solid var(--border-color);
    margin-top: 4rem;
  }

  .footer-content {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .footer-brand h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--text-color);
  }

  .footer-brand p {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .footer-links {
    display: flex;
    gap: 4rem;
    flex-wrap: wrap;
  }

  .link-group h4 {
    color: var(--text-color);
    margin-bottom: 1rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .link-group a {
    display: block;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
    transition: color 0.2s;
  }

  .link-group a:hover {
    color: var(--text-color);
  }

  .footer-bottom {
    text-align: left; /* Aligned left */
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
    color: var(--text-muted);
    font-size: 0.85rem;
  }
</style>
